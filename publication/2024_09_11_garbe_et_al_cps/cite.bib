author = {Lisa Garbe and Nina McMurry and Alexandra Scacco and Kelly Zhang},
title ={Who Wants to be Legible? Digitalization and Intergroup Inequality in Kenya},

journal = {Comparative Political Studies},
volume = {58},
number = {9},
pages = {1803-1853},
year = {2025},
doi = {10.1177/00104140241276971},

URL = {

        https://doi.org/10.1177/00104140241276971



},
